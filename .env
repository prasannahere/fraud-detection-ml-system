# =============================================================================
# Fraud Detection ML System — environment configuration
# Used by docker-compose and local runs (python-dotenv)
# =============================================================================

# --- Fraud API (JWT auth) ---
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=60
FRAUD_AUTH_USERNAME=admin
FRAUD_AUTH_PASSWORD=admin
MODEL_VERSION=v1

# --- Fraud API (optional GCP audit) ---
ENABLE_AUDIT=false
GCP_PROJECT=
BIGQUERY_DATASET=fraud_ml
BIGQUERY_TABLE=prediction_audit

# --- Stream service ---
DATA_FILE_PATH=/data/sample_transactions.csv
STREAM_INTERVAL_SECONDS=1

# --- Frontend (Vite build-time URLs, browser-facing) ---
VITE_FRAUD_API_URL=http://localhost:8000
VITE_STREAM_API_URL=http://localhost:8001
