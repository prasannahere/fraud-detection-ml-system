# Copy to .env and adjust for your environment (never commit .env — use GitHub Secrets in prod)

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
# Pipe-separated user:password pairs for dashboard login
FRAUD_AUTH_USERS=prasanna:your-password|harshith:your-password|harshit:your-password
# Stream-service uses this account to score transactions server-side
FRAUD_AUTH_USERNAME=prasanna
FRAUD_AUTH_PASSWORD=your-password

MODEL_VERSION=v1
ENABLE_AUDIT=false
GCP_PROJECT=
BIGQUERY_DATASET=fraud_ml
BIGQUERY_TABLE=prediction_audit

DATA_FILE_PATH=data/sample_transactions.csv
STREAM_INTERVAL_SECONDS=0.5

# stream server-side scoring (optional; omit API_URL to disable)
API_URL=http://localhost:8000
FRAUD_THRESHOLD=0.8

VITE_API_URL=http://localhost:8000
VITE_STREAM_API_URL=http://localhost:8001

# GCP (training / pipelines / infra containers)
GCP_PROJECT_ID=fraud-detection-500117
GCP_REGION=us-central1
AR_HOST=us-central1-docker.pkg.dev
AR_REPOSITORY=fraud-detection-repo
GCS_ARTIFACTS_BUCKET=fraud-detection-500117-artifacts
TRAINING_IMAGE=us-central1-docker.pkg.dev/fraud-detection-500117/fraud-detection-repo/training:latest
INFRA_IMAGE=us-central1-docker.pkg.dev/fraud-detection-500117/fraud-detection-repo/infra:latest
OUTPUT_PREFIX=models/xgb95
