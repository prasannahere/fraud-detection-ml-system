# Copy to .env and adjust for your environment (never commit .env — use GitHub Secrets in prod)

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
FRAUD_AUTH_USERNAME=admin
FRAUD_AUTH_PASSWORD=change-me

MODEL_VERSION=v1
ENABLE_AUDIT=false
GCP_PROJECT=
BIGQUERY_DATASET=fraud_ml
BIGQUERY_TABLE=prediction_audit

DATA_FILE_PATH=/data/sample_transactions.csv
STREAM_INTERVAL_SECONDS=1

# stream-service server-side scoring (optional; omit FRAUD_API_URL to disable)
FRAUD_API_URL=http://localhost:8000
FRAUD_THRESHOLD=0.8

VITE_FRAUD_API_URL=http://localhost:8000
VITE_STREAM_API_URL=http://localhost:8001
